{
  "name": "ionic-app-base",
  "version": "0.0.0",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ensure-map-key.js && ng serve",
    "build": "node scripts/ensure-map-key.js && ng build",
    "android:dev": "node scripts/ensure-map-key.js && ng build --configuration development && npx cap sync android",
    "android:prod": "node scripts/ensure-map-key.js && ng build && npx cap sync android",
    "apk:site": "node scripts/build-site-apk.mjs",
    "adb:reverse": "node scripts/adb-reverse.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/ensure-map-key.js && ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
