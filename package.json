    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/leaflet": "^1.9.22",
    "angular-eslint": "22.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^26.0.0",
